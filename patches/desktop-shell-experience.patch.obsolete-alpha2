+      }
+      picker.querySelector('.lbl').textContent = active.getAttribute('aria-label') || '面板';
+      const signature = rows.map((b) => (b.getAttribute('aria-label') || '')
+        + (b.getAttribute('aria-current') === 'page' ? '*' : '')).join('|');
+      const menu = document.getElementById('__dsh_panel_menu');
+      if (menu.dataset.sig !== signature) {
+        menu.dataset.sig = signature;
+        menu.textContent = '';
+        rows.forEach((b) => {
+          const item = document.createElement('button');
+          item.type = 'button';
+          item.className = 'item' + (b.getAttribute('aria-current') === 'page' ? ' on' : '');
+          item.textContent = b.getAttribute('aria-label') || '';
+          item.addEventListener('click', (ev) => {
+            ev.stopPropagation();
+            b.click();
+            menu.classList.remove('open');
+          });
+          menu.appendChild(item);
+        });
+      }
+      /* Merge the picker into the row that already shows the panel title: that row carries the
+         search/filter/new buttons, so the title and the picker do not say the same thing twice. */
+      const activeLabel = active.getAttribute('aria-label') || '';
+      const scope = row.closest('[class*="_sidebarCol"]') || document;
+      let hosted = false;
+      for (const el of scope.querySelectorAll('div, span')) {
+        if (el.children.length || el.closest('#__dsh_panel_picker') || el.closest('#__dsh_panel_menu')) continue;
+        if ((el.textContent || '').trim() !== activeLabel) continue;
+        const parent = el.parentElement;
+        if (!parent) continue;
+        if (!parent.querySelector('button')) continue;
+        el.style.setProperty('display', 'none', 'important');
+        if (!parent.contains(picker)) parent.insertBefore(picker, parent.firstChild);
+        hosted = true;
+      }
+      const narrow = sidebarWidth() < 200;
+      const force = (el, wide) => { if (el) el.style.setProperty('display', wide ? 'inline-flex' : 'none', 'important'); };
+      force(picker, !narrow);
+      if (hosted) row.style.setProperty('display', 'none', 'important');
+      const newSession = document.querySelector('[class*="_newSession"]');
+      if (newSession) newSession.style.setProperty('display', 'none', 'important');
+      if (list) list.style.setProperty('display', narrow ? 'flex' : 'none', 'important');
+    };
+
+    const sample = () => {
+      /* While the sidebar is collapsed the sample point lands on a different surface, so the
+         bar keeps the color it already has instead of flipping on every toggle. */
+      const narrow = sidebarWidth() < 200;
+      ensurePicker();
+      if (narrow && window.__dshShellBarColor) return;
+      let color = chromeColor();
+      if (!color) {
+        color = pick(document.body);
+        if (!opaque(color)) color = pick(document.documentElement);
+      }
+      if (!opaque(color)) color = window.__dshShellBarColor || 'rgb(255, 255, 255)';
+      if (color === window.__dshShellBarColor) return;
+      window.__dshShellBarColor = color;
+      document.documentElement.style.setProperty('--dsh-shell-bar-bg', color);
+      const api = window.dshDesktop && window.dshDesktop.shell;
+      if (api && api.titlebarColor) api.titlebarColor(color);
+    };
+
+    /* Sampling is event-driven: a page that repaints on scroll must not queue a layout read per
+       animation frame, and the color rarely changes at all. */
+    const scheduleSample = () => {
+      if (window.__dshSampleTimer) return;
+      window.__dshSampleTimer = setTimeout(() => {
+        window.__dshSampleTimer = 0;
+        try { sample(); } catch (e) {}
+      }, 120);
+    };
+
+    sample();
+    if (!window.__dshShellBarObs) {
+      window.__dshShellBarObs = 1;
+      try {
+        window.__dshSidebarObs = new ResizeObserver(scheduleSample);
+        const col = document.querySelector('[class*="_sidebarCol"]');
+        if (col) window.__dshSidebarObs.observe(col);
+      } catch (e) {}
+      try {
+        new MutationObserver(scheduleSample).observe(document.documentElement,
+          { attributes: true, attributeFilter: ['class', 'style', 'data-theme'] });
+      } catch (e) {}
+      window.addEventListener('resize', scheduleSample);
+      window.addEventListener('focus', scheduleSample);
+      setInterval(scheduleSample, 5000);
+    }
+  })()`
+}
+
+/**
+ * Install the shell bar and sidebar ergonomics into one application document.
+ * @param contents - Renderer showing the application page.
+ * @param options - Bar brand mark and behaviour.
+ */
+export function installShellBar(contents: WebContents, options: ShellBarOptions): void {
+  if (contents.isDestroyed()) return
+  contents.insertCSS(shellBarCss(options)).catch(() => undefined)
+  void contents.executeJavaScript(shellBarScript(options), true).catch(() => undefined)
+}
+
+/** Notification-area menu copy and callbacks. */
+export interface ShellTrayOptions {
+  readonly tooltip: string
+  readonly openLabel: string
+  readonly pluginsLabel: string
+  readonly updatesLabel: string
+  readonly quitLabel: string
+  readonly onOpen: () => void
+  readonly onPlugins: () => void
+  readonly onUpdates: () => void
+  readonly onQuit: () => void
+}
+
+/**
+ * Create the icon that keeps the application resident after its window is closed.
+ * @param options - Menu copy and callbacks owned by the shell.
+ * @returns The tray, or undefined when the packaging step shipped no usable image.
+ */
+export function createShellTray(options: ShellTrayOptions): Tray | undefined {
+  const image = shellTrayImage()
+  if (image === undefined) return undefined
+  const tray = new Tray(image)
+  tray.setToolTip(options.tooltip)
+  tray.setContextMenu(Menu.buildFromTemplate([
+    { label: options.openLabel, click: options.onOpen },
+    { type: 'separator' },
+    { label: options.pluginsLabel, click: options.onPlugins },
+    { label: options.updatesLabel, click: options.onUpdates },
+    { type: 'separator' },
+    { label: options.quitLabel, click: options.onQuit },
+  ]))
+  tray.on('click', options.onOpen)
+  tray.on('double-click', options.onOpen)
+  return tray
+}
