+/**
+ * Shell-owned window chrome: our own title bar, the sidebar ergonomics that go with it,
+ * and the notification-area icon that keeps the application resident after its window closes.
+ *
+ * The page rules below address kernel-generated markup by the stable suffix of its class names
+ * (`_logoRow`, `_panelList`, ...). The hash prefix of those names changes between kernel
+ * releases, so a rename degrades this chrome to "no extra polish" instead of breaking the page.
+ */
+
+import { existsSync, readFileSync } from 'node:fs'
+import { join } from 'node:path'
+import {
+  Menu,
+  nativeImage,
+  Tray,
+  type BrowserWindow,
+  type NativeImage,
+  type WebContents,
+} from 'electron'
+
+/** Height of the shell-owned window bar; the native caption buttons are aligned to it. */
+export const SHELL_BAR_HEIGHT = 34
+
+/** Caption-button colors used before the page reports its own background. */
+const DEFAULT_SYMBOL_COLOR = '#4b5563'
+
+function shellAsset(name: string): string | undefined {
+  const path = join(process.resourcesPath, 'assets', name)
+  return existsSync(path) ? path : undefined
+}
+
+/** Window and taskbar icon shipped beside the application, when the packaging step provided one. */
+export function shellWindowIcon(): string | undefined {
+  return shellAsset('app-icon.png')
+}
+
+function shellTrayImage(): NativeImage | undefined {
+  for (const name of ['tray-icon.png', 'app-icon.png']) {
+    const path = shellAsset(name)
+    if (path === undefined) continue
+    const image = nativeImage.createFromPath(path)
+    if (!image.isEmpty()) return image
+  }
+  return undefined
+}
+
+/**
+ * Read the kernel's own brand mark so the shell bar always matches the installed release.
+ * @param dshRoot - Root of the packaged dsh runtime.
+ * @returns CSS-ready data URI, or an empty string when the asset is unavailable.
+ */
+export function shellBrandMark(dshRoot: string): string {
+  try {
+    const file = join(dshRoot, 'node_modules', '@deepseek-ai', 'dsh-web-frontend', 'dist', 'favicon.svg')
+    return `data:image/svg+xml;base64,${readFileSync(file).toString('base64')}`
+  } catch {
+    return ''
+  }
+}
+
+function overlayFor(background: string): { color: string; symbolColor: string } {
+  const match = /rgba?\(\s*(\d+)[,\s]+(\d+)[,\s]+(\d+)/u.exec(background)
+  if (match === null) return { color: background, symbolColor: DEFAULT_SYMBOL_COLOR }
+  const luma = 0.2126 * Number(match[1]) + 0.7152 * Number(match[2]) + 0.0722 * Number(match[3])
+  return { color: background, symbolColor: luma < 140 ? '#e8eaed' : DEFAULT_SYMBOL_COLOR }
+}
+
+/**
+ * Repaint the native caption strip so it never looks pasted onto the page.
+ * @param window - Window whose title bar is hidden.
+ * @param background - Opaque CSS color sampled from the page.
+ */
+export function applyTitlebarColor(window: BrowserWindow, background: string): void {
+  const overlay = overlayFor(background)
+  try {
+    window.setBackgroundColor(background)
+    window.setTitleBarOverlay({ ...overlay, height: SHELL_BAR_HEIGHT })
+  } catch {
+    // setTitleBarOverlay is Windows/Linux-only; a window without the overlay simply keeps its color.
+  }
+}
+
+/** Options for {@link installShellBar}. */
+export interface ShellBarOptions {
+  /** Data URI of the brand mark drawn at the bar's left edge; an empty string hides it. */
+  readonly mark: string
+  /** Whether clicking the brand mark collapses the sidebar. */
+  readonly markTogglesSidebar: boolean
+}
+
+function shellBarCss(options: ShellBarOptions): string {
+  return `
+    body { padding-top: ${String(SHELL_BAR_HEIGHT)}px !important; box-sizing: border-box !important; }
+    #__dsh_shell_bar {
+      position: fixed; top: 0; left: 0; right: 0; height: ${String(SHELL_BAR_HEIGHT)}px;
+      display: flex; align-items: center; padding: 0 12px;
+      -webkit-app-region: drag; user-select: none; pointer-events: auto;
+      background: var(--dsh-shell-bar-bg, transparent);
+      z-index: 2147483000;
+    }
+    #__dsh_shell_bar .mark {
+      width: 18px; height: 18px;
+      background-image: ${options.mark === '' ? 'none' : `url("${options.mark}")`};
+      background-size: contain; background-repeat: no-repeat; background-position: center;
+      /* The mark collapses the sidebar, so it must not be a drag region: dragging would
+         otherwise swallow the click. */
+      -webkit-app-region: no-drag; cursor: pointer; border-radius: 6px; padding: 2px; box-sizing: content-box;
+    }
+    #__dsh_shell_bar .mark.hidden { display: none !important; }
+    #__dsh_shell_bar .mark:hover { background-color: rgba(127, 127, 127, .14); }
+
+    /* The sidebar's own brand row repeats the bar above it, and its collapse button moved into
+       the bar, so the whole row collapses to zero height and the panel list takes its place. */
+    [class*="_logoRow"] [class*="_brandIdentity"],
+    [class*="_logoRow"] [class*="_brand"],
+    [class*="_logoRow"] > button { display: none !important; }
+    [class*="_logoRow"] {
+      height: 0 !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important;
+      justify-content: flex-start !important;
+    }
+    [class*="_collapsed"] [class*="_logoRow"] {
+      height: 0 !important; min-height: 0 !important; margin: 0 !important; padding: 0 !important;
+    }
+    [class*="_panelList"] { display: none !important; }
+
+    /* Panel picker ("workspace ⌄"), merged into the row that already carries the title. */
+    #__dsh_panel_picker {
+      position: relative; display: inline-flex; align-items: center; gap: 6px;
+      -webkit-app-region: no-drag; cursor: pointer; padding: 5px 10px; margin-left: -10px; border-radius: 8px;
+      font: 600 14px/1 "Segoe UI", system-ui, sans-serif; color: var(--dsw-alias-label-primary, #111);
+      user-select: none;
+    }
+    #__dsh_panel_picker:hover { background: var(--dsw-alias-interactive-bg-hover, rgba(0, 0, 0, .05)); }
+    #__dsh_panel_picker .chev { display: inline-flex; width: 12px; height: 12px; opacity: .5; }
+    #__dsh_panel_picker .chev svg { display: block; }
+    /* The menu lives on <body>: the sidebar row clips its overflow, which would hide a nested menu. */
+    #__dsh_panel_menu {
+      display: none; position: fixed; min-width: 168px; padding: 6px;
+      border-radius: 10px;
+      background: var(--dsw-alias-bg-overlay, var(--dsw-alias-bg-layer-1, #fff));
+      color: var(--dsw-alias-label-primary, #111);
+      font-family: inherit;
+      box-shadow: 0 10px 30px var(--dsw-alias-bg-mask-2, rgba(0, 0, 0, .16));
+      border: 1px solid var(--dsw-alias-border-l3, var(--dsw-alias-border-l2, rgba(0, 0, 0, .08)));
+      z-index: 2147483001;
+    }
+    #__dsh_panel_menu.open { display: block; }
+    #__dsh_panel_menu .item {
+      display: block; width: 100%; text-align: left; padding: 8px 10px; border: none;
+      background: transparent; border-radius: 7px; cursor: pointer;
+      font: 500 13px/1.2 "Segoe UI", system-ui, sans-serif; color: var(--dsw-alias-label-primary, #111);
+    }
+    #__dsh_panel_menu .item:hover { background: var(--dsw-alias-interactive-bg-hover, rgba(0, 0, 0, .05)); }
+    #__dsh_panel_menu .item.on { font-weight: 600; }
+
+    /* The kernel's full-width "new session" button: held down by every paintable property so
+       React remounting it during a sidebar toggle cannot flash it for one frame. New sessions
+       are started from the entry on the title row instead. */
+    [class*="_newSession"] {
+      display: none !important; visibility: hidden !important;
+      width: 0 !important; height: 0 !important; min-width: 0 !important; min-height: 0 !important;
+      margin: 0 !important; padding: 0 !important; overflow: hidden !important;
+    }
+
+    /* The workspace reads as a white card floating on the sidebar's gray: round the content
+       column and keep a small gap on the right and bottom so the corners are actually visible. */
+    [class*="_frame"] { background: var(--dsh-shell-bar-bg, #F9FAFB) !important; }
+    [class*="_centerCol"] { border-radius: 10px !important; overflow: hidden !important; margin: 0 6px 6px 0 !important; }
+    [class*="_centerCol"] [class*="_root"] { border-radius: 10px !important; }
+    #__dsh_panel_picker, #__dsh_panel_menu { transition: none !important; }
+  `
+}
+
+function shellBarScript(options: ShellBarOptions): string {
+  return String.raw`(() => {
+    const MARK = ${JSON.stringify(options.mark)};
+    const TOGGLES = ${options.markTogglesSidebar ? 'true' : 'false'};
+    const CLEAR = ['rgba(0, 0, 0, 0)', 'transparent', ''];
+    const parse = (c) => {
+      const m = /rgba?\(([^)]+)\)/.exec(String(c || ''));
+      if (!m) return null;
+      const p = m[1].split(',').map((s) => Number(s.trim()));
+      if (p.length < 3 || p.some((n) => Number.isNaN(n))) return null;
+      return { r: p[0], g: p[1], b: p[2], a: p.length >= 4 ? p[3] : 1 };
+    };
+    const opaque = (c) => { const p = parse(c); return !!p && p.a >= 0.95; };
+    const over = (src, dst) => {
+      const s = parse(src);
+      const d = parse(dst);
+      if (!s || !d) return dst;
+      const a = s.a + d.a * (1 - s.a);
+      if (a <= 0) return dst;
+      const mix = (x, y) => Math.round((x * s.a + y * d.a * (1 - s.a)) / a);
+      return 'rgb(' + mix(s.r, d.r) + ', ' + mix(s.g, d.g) + ', ' + mix(s.b, d.b) + ')';
+    };
+    const pick = (el) => (el ? getComputedStyle(el).backgroundColor : '');
+
+    /** Sample the chrome color under the bar: stacked semi-transparent layers included, so an
+     *  open dialog mask cannot make the bar lighter than the page it sits on. */
+    const chromeColor = () => {
+      let el = document.elementFromPoint(24, ${String(SHELL_BAR_HEIGHT)} + 40);
+      const layers = [];
+      while (el) {
+        const c = pick(el);
+        if (opaque(c)) {
+          let out = c;
+          for (let i = layers.length - 1; i >= 0; i--) out = over(layers[i], out);
+          return out;
+        }
+        if (c && CLEAR.indexOf(c) === -1) layers.push(c);
+        el = el.parentElement;
+      }
+      return '';
+    };
+    const sidebarWidth = () => {
+      const col = document.querySelector('[class*="_sidebarCol"]');
+      return col ? (col.clientWidth || 999) : 999;
+    };
+
+    let bar = document.getElementById('__dsh_shell_bar');
+    if (!bar) {
+      bar = document.createElement('div');
+      bar.id = '__dsh_shell_bar';
+      const mark = document.createElement('span');
+      mark.className = 'mark';
+      if (MARK === '') mark.classList.add('hidden');
+      bar.appendChild(mark);
+      (document.body || document.documentElement).appendChild(bar);
+    }
+    const mark = bar.querySelector('.mark');
+    if (mark) mark.title = '收起 / 展开侧栏';
+
