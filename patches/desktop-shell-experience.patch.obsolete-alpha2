+      const row = document.querySelector('[class*="_logoRow"]');
+      if (!row) return;
+      const buttons = Array.prototype.filter.call(row.querySelectorAll('button'),
+        (b) => b.id !== '__dsh_new_session');
+      const button = buttons[buttons.length - 1];
+      if (button) button.click();
+    };
+    if (!window.__dshShellBarWired) {
+      window.__dshShellBarWired = 1;
+      document.addEventListener('click', (ev) => {
+        const t = ev.target;
+        if (TOGGLES && t && t.closest && t.closest('#__dsh_shell_bar .mark')) {
+          ev.stopPropagation();
+          toggleSidebar();
+        }
+      }, true);
+      document.addEventListener('mousedown', (ev) => {
+        const t = ev.target;
+        if (t && t.closest && t.closest('#__dsh_shell_bar')) ev.stopPropagation();
+      }, true);
+    }
