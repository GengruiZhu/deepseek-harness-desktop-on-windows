+/**
+ * Content fingerprint of one plugin package: the relative path, byte length and SHA-256 of every
+ * file inside it.
+ *
+ * The profile copy is compared against this instead of the manifest version alone, because a
+ * plugin that keeps its version number while its sources change would otherwise stay stale in
+ * every profile that an earlier build materialized.
+ * @param directory - Plugin package directory.
+ * @returns The fingerprint, or undefined when the directory cannot be walked; the caller then
+ * falls back to the manifest version, which is all the previous implementation looked at.
+ */
+function pluginFingerprint(directory: string): string | undefined {
+  const entries: string[] = []
+  const walk = (current: string, prefix: string): void => {
+    const children = readdirSync(current, { withFileTypes: true })
+      .sort((left, right) => left.name.localeCompare(right.name))
+    for (const child of children) {
+      if (child.name.startsWith('.')) continue
+      const relative = prefix === '' ? child.name : `${prefix}/${child.name}`
+      const absolute = join(current, child.name)
+      if (child.isDirectory()) {
+        walk(absolute, relative)
+        continue
+      }
+      if (!child.isFile()) continue
+      const body = readFileSync(absolute)
+      entries.push(`${relative} ${String(body.byteLength)} ${createHash('sha256').update(body).digest('hex')}`)
+    }
+  }
+  try {
+    walk(directory, '')
+    return createHash('sha256').update(entries.join('\n')).digest('hex')
+  } catch {
+    return undefined
+  }
+}
