+import { join } from 'node:path'
+import {
+  Menu,
+  nativeImage,
+  Tray,
+  type NativeImage,
+} from 'electron'
+
+function shellAsset(name: string): string | undefined {
+  const path = join(process.resourcesPath, 'assets', name)
+  return existsSync(path) ? path : undefined
+}
+
+/** Window and taskbar icon shipped beside the application, when the packaging step provided one. */
+export function shellWindowIcon(): string | undefined {
+  return shellAsset('app-icon.png')
+}
+
+function shellTrayImage(): NativeImage | undefined {
+  for (const name of ['tray-icon.png', 'app-icon.png']) {
+    const path = shellAsset(name)
+    if (path === undefined) continue
+    const image = nativeImage.createFromPath(path)
+    if (!image.isEmpty()) return image
+  }
+  return undefined
+}
+
+/** Options for {@link createShellTray}. */
+export interface ShellTrayOptions {
+  readonly tooltip: string
+  readonly openLabel: string
+  readonly quitLabel: string
+  readonly onOpen: () => void
+  readonly onQuit: () => void
+}
