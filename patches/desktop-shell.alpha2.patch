diff --git a/apps/desktop/src/shell-ui.ts b/apps/desktop/src/shell-ui.ts
new file mode 100644
index 00000000..1c81c195
--- /dev/null
+++ b/apps/desktop/src/shell-ui.ts
@@ -0,0 +1,69 @@
+/**
+ * Shell-owned chrome that the official desktop layer does not provide: the packaged window icon
+ * and the notification-area icon that keeps the application resident after its window closes.
+ *
+ * As of dsh 0.1.6-alpha.2 the official desktop layer owns the rest of the window chrome itself:
+ * `main.ts` sets `titleBarStyle: 'hidden'` with the caption height from `windows-layout.ts`, the
+ * application document repaints that strip through the `windowsAppearance` IPC, and the client
+ * lays its sidebar out for it from the `data-windows-titlebar` attribute
+ * (`packages/client/ui-sidebar/src/client/SidebarRoot.module.css`). Painting the same strip from
+ * here would fight that code, so this module deliberately keeps no copy of it.
+ */
+
+import { existsSync } from 'node:fs'
+import { join } from 'node:path'
+import {
+  Menu,
+  nativeImage,
+  Tray,
+  type NativeImage,
+} from 'electron'
+
+function shellAsset(name: string): string | undefined {
+  const path = join(process.resourcesPath, 'assets', name)
+  return existsSync(path) ? path : undefined
+}
+
+/** Window and taskbar icon shipped beside the application, when the packaging step provided one. */
+export function shellWindowIcon(): string | undefined {
+  return shellAsset('app-icon.png')
+}
+
+function shellTrayImage(): NativeImage | undefined {
+  for (const name of ['tray-icon.png', 'app-icon.png']) {
+    const path = shellAsset(name)
+    if (path === undefined) continue
+    const image = nativeImage.createFromPath(path)
+    if (!image.isEmpty()) return image
+  }
+  return undefined
+}
+
+/** Options for {@link createShellTray}. */
+export interface ShellTrayOptions {
+  readonly tooltip: string
+  readonly openLabel: string
+  readonly quitLabel: string
+  readonly onOpen: () => void
+  readonly onQuit: () => void
+}
+
+/**
+ * Install the notification-area icon that owns the application lifecycle while the window is hidden.
+ * @param options - Localized labels and the two lifecycle callbacks.
+ * @returns The icon, or undefined when no icon asset was packaged or the platform cannot show one.
+ */
+export function createShellTray(options: ShellTrayOptions): Tray | undefined {
+  const image = shellTrayImage()
+  if (image === undefined) return undefined
+  const tray = new Tray(image)
+  tray.setToolTip(options.tooltip)
+  tray.setContextMenu(Menu.buildFromTemplate([
+    { label: options.openLabel, click: options.onOpen },
+    { type: 'separator' },
+    { label: options.quitLabel, click: options.onQuit },
+  ]))
+  // A left click on the icon is the fastest way back to a hidden window.
+  tray.on('click', options.onOpen)
+  return tray
+}
