index 00000000..35345f0b
--- /dev/null
+++ b/apps/desktop/scripts/collect-app-dependencies.mjs
@@ -0,0 +1,126 @@
+/**
+ * Collect the package directories the packaged application must carry.
+ *
+ * electron-builder collects the application's production dependencies from package.json, but this
+ * workspace links first-party packages (`link:`/`workspace:`), and a linked package's own
+ * dependencies live in ITS node_modules rather than in the application's. Those nested dependencies
+ * therefore never reach `app.asar/node_modules`, and the packaged application fails at startup with
+ * `ERR_MODULE_NOT_FOUND` for e.g. `@deepseek-ai/cordis-plugin-loader` — which is invisible on the
+ * build host, where Node happily resolves the missing package from the repository above the output
+ * directory.
+ *
+ * This walks from the application's own built files through every bare specifier they reach,
+ * resolving with the application's own module resolution so pnpm's links are followed, and returns
+ * one directory per package. The caller adds them as electron-builder file sets.
+ */
+
+import { readFileSync, readdirSync, statSync } from 'node:fs'
+import { createRequire } from 'node:module'
+import { dirname, join, sep } from 'node:path'
+
+/** Modules the Node runtime provides; they must never be copied into the application. */
+const BUILTINS = new Set(['assert', 'async_hooks', 'buffer', 'child_process', 'cluster', 'console', 'constants',
+  'crypto', 'dgram', 'diagnostics_channel', 'dns', 'domain', 'events', 'fs', 'http', 'http2', 'https', 'inspector',
+  'module', 'net', 'os', 'path', 'perf_hooks', 'process', 'punycode', 'querystring', 'readline', 'repl', 'stream',
+  'string_decoder', 'sys', 'timers', 'tls', 'trace_events', 'tty', 'url', 'util', 'v8', 'vm', 'wasi',
+  'worker_threads', 'zlib'])
+
+/** Specifiers the Electron runtime itself provides to the main process and preloads. */
+const PROVIDED = new Set(['electron'])
+
+const SPECIFIER = /(?:^|[^\w.$])(?:import|export)[^'"`]*?from\s*["']([^"']+)["']|(?:^|[^\w.$])require\(\s*["']([^"']+)["']\s*\)|(?:^|[^\w.$])import\(\s*["']([^"']+)["']\s*\)/gu
+
+const packageNameOf = specifier => {
+  const parts = specifier.split('/')
+  return specifier.startsWith('@') ? `${parts[0]}/${parts[1]}` : parts[0]
+}
+
+/** Every ".js"/".cjs"/".mjs" file below one directory, skipping nested node_modules. */
+function scriptFiles(root, depth = 0) {
+  const found = []
+  if (depth > 6) return found
+  let entries
+  try { entries = readdirSync(root, { withFileTypes: true }) } catch { return found }
+  for (const entry of entries) {
+    const path = join(root, entry.name)
+    if (entry.isDirectory()) {
+      if (entry.name === 'node_modules') continue
+      found.push(...scriptFiles(path, depth + 1))
+      continue
+    }
+    if (entry.isFile() && /\.(?:js|cjs|mjs)$/u.test(entry.name)) found.push(path)
+  }
+  return found
+}
+
+function packageRootOf(resolved, name) {
+  let current = dirname(resolved)
+  for (;;) {
+    try {
+      const manifest = JSON.parse(readFileSync(join(current, 'package.json'), 'utf8'))
+      if (manifest.name === name) return current
+    } catch { /* keep walking up */ }
+    const parent = dirname(current)
+    if (parent === current || current.endsWith(`${sep}node_modules`)) return dirname(resolved)
+    current = parent
+  }
+}
+
+/**
+ * @param {string} appRoot - Desktop application directory.
+ * @param {readonly string[]} extraRoots - Additional directories to seed the walk (built renderer assets).
+ * @returns {Map<string, string>} package name to its directory on this build host.
+ */
+export function collectApplicationPackages(appRoot, extraRoots = []) {
+  const packages = new Map()
+  const requires = new Map()
+  // Resolve each specifier the way Node does for that file: a linked package's own dependencies
+  // only resolve from inside it, not from the application root.
+  const requireOf = file => {
+    const directory = dirname(file)
+    let created = requires.get(directory)
+    if (created === undefined) {
+      created = createRequire(file)
+      requires.set(directory, created)
+    }
+    return created
+  }
+  const scanned = new Set()
+  const queue = []
+  const enqueue = path => {
+    if (scanned.has(path)) return
+    scanned.add(path)
+    queue.push(path)
+  }
+
+  for (const file of [...scriptFiles(join(appRoot, 'lib')), ...extraRoots.flatMap(root => scriptFiles(root))]) {
+    enqueue(file)
+  }
+
+  while (queue.length > 0) {
+    const file = queue.pop()
+    let text
+    try { text = readFileSync(file, 'utf8') } catch { continue }
+    for (const match of text.matchAll(SPECIFIER)) {
+      const specifier = match[1] ?? match[2] ?? match[3]
+      if (specifier === undefined) continue
+      if (specifier.startsWith('.') || specifier.startsWith('node:') || specifier.startsWith('data:')) continue
+      // Subpath imports ("#internal") and bundler placeholder specifiers have no package to copy.
+      if (specifier.startsWith('#')) continue
+      const name = packageNameOf(specifier)
+      if (BUILTINS.has(name) || PROVIDED.has(name)) continue
+
+      let resolved
+      try { resolved = requireOf(file).resolve(`${name}/package.json`) }
+      catch {
+        try { resolved = requireOf(file).resolve(specifier) } catch { continue }
+      }
+      const root = packageRootOf(resolved, name)
+      if (packages.has(name)) continue
+      packages.set(name, root)
+      for (const entry of scriptFiles(root)) enqueue(entry)
+    }
+  }
+
+  return packages
+}
