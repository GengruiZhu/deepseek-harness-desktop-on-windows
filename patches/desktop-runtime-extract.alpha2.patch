+/**
+ * Unpack a locked library wheel, retaining auxiliary scripts in its distribution data directory.
+ * @param archive - Hash-verified wheel archive.
+ * @param destination - Absolute site-packages directory.
+ * @returns Resolves after extraction without command wrappers; rejects other wheel installation schemes.
+ */
+/**
+ * Extract a Windows ZIP with the bsdtar that ships inside Windows.
+ *
+ * extract-zip 2.0.1 stalls partway through the Node.js Windows distribution archive on this build
+ * host (it stops after a handful of entries and never settles, so preparation hangs instead of
+ * failing), while the bundled `tar.exe` unpacks the identical archive in under a second. Only the
+ * large interpreter archive takes this path; small wheels keep extract-zip so their entry-scheme
+ * validation still runs.
+ * @param archive - Absolute path of the ZIP to extract.
+ * @param destination - Absolute directory that receives the archive contents.
+ */
+function extractWindowsArchive(archive: string, destination: string): void {
+  const result = spawnSync('tar', ['-xf', archive, '-C', destination], { encoding: 'utf8' })
+  if (result.error !== undefined || result.status !== 0) {
+    const detail = result.error?.message ?? result.stderr.trim()
+    throw new Error(`primary runtime: tar could not extract ${archive}: ${detail === '' ? `exit ${String(result.status)}` : detail}`)
+  }
+}
